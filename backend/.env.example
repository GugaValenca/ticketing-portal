# Copy this file to .env for local development. Production values are
# set as real environment variables (Vercel project settings / Docker
# Compose), never committed.

# Required in production; a local-only fallback is used if unset.
DJANGO_SECRET_KEY=change-me-generate-a-real-key-for-production

# Never enable in production.
DEBUG=1

# Comma-separated. Defaults already cover local dev if left unset.
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Optional: overrides the JWT cookie policy (auto-derived from DEBUG
# otherwise - see config/settings.py).
# AUTH_COOKIE_SECURE=false
# AUTH_COOKIE_SAMESITE=Lax

# Leave unset to fall back to local SQLite. Set to a postgres:// URL
# (e.g. from docker-compose.yml) to use Postgres instead.
# DATABASE_URL=postgres://ticketing:ticketing@localhost:5432/ticketing

# Used to build the link inside password reset emails.
FRONTEND_URL=http://localhost:5173

# Optional: without these, password reset emails print to the console/log
# instead of actually sending - the flow still works end to end locally.
# Set them (e.g. to an SMTP provider's credentials) to send real emails.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=no-reply@nexalink-telecom.example
